APP_NAME="Softflyer API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=factura_softfly
# Rol de la API: sin superusuario ni BYPASSRLS (ver database/setup/crear_bd_local.sql)
DB_USERNAME=softflyer_app # por defcto redigb solo tien postgres como suario de su db
DB_PASSWORD=
# DB_ROLE=softflyer_app   # solo si DB_USERNAME es superusuario (p. ej. postgres de Laragon): así RLS sí aplica
# Rol duenio del esquema: php artisan migrate --database=pgsql_owner
DB_OWNER_USERNAME=softflyer_owner
DB_OWNER_PASSWORD=

SOFTFLYER_DOMINIO_CENTRAL=localhost
SANCTUM_EXPIRATION=480
SOFTFLYER_FRONTEND_URL=http://localhost:3000
SOFTFLYER_PRUEBA_DIAS=7
SOFTFLYER_VENTAS_CORREO=

# Asistente IA (spec 040). Solo backend: nunca usar NEXT_PUBLIC_* para la clave.
# Verificar el nombre vigente del modelo Flash-Lite en la documentación de Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT=20
# GEMINI_API_STYLE=auto
# Local en Windows con antivirus/proxy que inspecciona TLS (ruta a un PEM con las raíces):
# GEMINI_CA_BUNDLE=C:/xampp/php/extras/ssl/windows-roots.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Tiempo real (spec 005). Local: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=softflyer
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Produccion: https://*.softflyer.pe
REVERB_ALLOWED_ORIGINS=*
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sin SMTP en local: MAIL_MAILER=log y los correos quedan en storage/logs/correos.log
# MAIL_LOG_CHANNEL=correos

# Gmail: usa una clave de aplicacion (no la contrasena de la cuenta)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SOFTLYERSAAS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
