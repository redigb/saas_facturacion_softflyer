API_URL=http://127.0.0.1:8000

# Dominio raiz: cada empresa entra por {slug}.APP_ROOT_DOMAIN
APP_ROOT_DOMAIN=localhost:3000

# Debe coincidir con SOFTFLYER_PRUEBA_DIAS del backend
PRUEBA_DIAS=7

# Cuenta demo publica (solo se usan en el servidor de Next)
DEMO_SLUG=demo
DEMO_CORREO=demo@softflyer.pe
DEMO_CONTRASENA=demo-softflyer

# Tiempo real (spec 005): debe coincidir con REVERB_APP_KEY / REVERB_PORT del backend.
# Sin NEXT_PUBLIC_REVERB_KEY el panel funciona igual, sin avisos instantaneos.
NEXT_PUBLIC_REVERB_KEY=
# Vacio = el host del subdominio actual (donjose.localhost en local)
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
