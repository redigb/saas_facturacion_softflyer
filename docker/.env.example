# Copia este archivo como .env en la RAÍZ del repositorio (junto a docker-compose.yml).
# Todo es opcional: sin .env se usan los valores de prueba de docker-compose.yml.

# Puertos publicados en tu equipo
WEB_PORT=3000
API_PORT=8000
REVERB_PUBLIC_PORT=8080
DB_PORT=5433
MAILPIT_PORT=8025

# Claves solo para pruebas. Cambiar contraseñas de la base exige `docker compose down -v`.
# APP_KEY=base64:...        # php artisan key:generate --show
# POSTGRES_PASSWORD=
# DB_OWNER_PASSWORD=
# DB_APP_PASSWORD=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
